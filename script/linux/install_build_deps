#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
cd "$REPO_ROOT"
source ./script/warp_sudo

if [[ "$(uname -s)" != "Linux" || "$(uname -m)" != "x86_64" ]]; then
  echo "This branch supports Linux x86_64 only." >&2
  exit 1
fi
source /etc/os-release
if [[ " $ID ${ID_LIKE:-} " != *" arch "* ]]; then
  echo "This bootstrap supports Arch Linux and derivatives, including Omarchy." >&2
  exit 1
fi

# Keep the host's existing GPU driver; the Vulkan loader uses its installed ICD.
PACKAGES=(
  base-devel cmake pkgconf curl git git-lfs python rustup
  openssl freetype2 expat libgit2 fontconfig alsa-lib clang protobuf sqlite
  libx11 libxcb libxi libxcursor libxkbcommon-x11 wayland libglvnd vulkan-icd-loader
)
warp_sudo pacman -S --needed --noconfirm "${PACKAGES[@]}"
