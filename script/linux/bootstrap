#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
cd "$REPO_ROOT"

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      echo "Usage: ./script/bootstrap [-y|--yes]"
      echo "Install build/runtime dependencies and the pinned Rust toolchain for Arch Linux x86_64."
      exit 0
      ;;
    -y|--yes) export WARP_SKIP_SUDO_PROMPT=1 ;;
    *) echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

./script/linux/install_build_deps

git lfs install --local
# Windows debug symbols are absent from this branch; only fetch shared model assets.
git lfs pull --include="crates/input_classifier/models/**"

export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
if ! command -v rustup >/dev/null 2>&1; then
  echo "rustup is required. Install it with: sudo pacman -S --needed rustup" >&2
  exit 1
fi
rustup show active-toolchain
rustup component add clippy rustfmt

echo "Ready. Run ./script/run --build to compile, or ./script/run to compile and launch."
