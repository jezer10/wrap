#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "$REPO_ROOT"

if [[ "$(uname -s)" != "Linux" || "$(uname -m)" != "x86_64" ]]; then
  echo "This branch supports Linux x86_64 only." >&2
  exit 1
fi

export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
if ! command -v rustc >/dev/null 2>&1; then
  echo "Rust is required. Run ./script/bootstrap first." >&2
  exit 1
fi
if [[ "$(rustc -vV)" != *"host: x86_64-unknown-linux-gnu"* ]]; then
  echo "A native x86_64-unknown-linux-gnu Rust toolchain is required." >&2
  exit 1
fi
if [[ -n "${CARGO_BUILD_TARGET:-}" && "$CARGO_BUILD_TARGET" != "x86_64-unknown-linux-gnu" ]]; then
  echo "CARGO_BUILD_TARGET must be x86_64-unknown-linux-gnu for this branch." >&2
  exit 1
fi

CARGO_COMMAND=run
if [[ "${1:-}" == "--build" ]]; then
  CARGO_COMMAND=build
  shift
fi

exec cargo "$CARGO_COMMAND" --locked --package warp --bin warp-oss --features gui \
  --target x86_64-unknown-linux-gnu "$@"
